# Copy to ".env" (git-ignored) and change the values:  cp .env.example .env
# docker compose reads .env automatically. Never commit the real file.

# SQL Server "sa" password. Must satisfy the SQL Server complexity policy (8+ chars, upper, lower, digit, symbol).
MSSQL_SA_PASSWORD=Change_me_Str0ng!

# PostgreSQL (Hangfire job storage) password.
POSTGRES_PASSWORD=change_me
